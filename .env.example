# ตัวอย่างค่าตั้งของ hr-service (รวมระบบรถร่วม Mixer แล้ว) — **ห้ามใส่ค่าจริงในไฟล์นี้**
# คัดลอกเป็น .env.local แล้วเติมค่า · บน Vercel ตั้งใน Project Settings → Environment Variables

# ── ฐานข้อมูล (คลัสเตอร์เดียว ใช้ MongoClient ตัวเดียว) ─────────────────────
MONGO_URI=
# db ของ hr — ค่าเริ่ม hr_service
MONGO_DB=hr_service
# db ของระบบรถร่วม — ค่าเริ่ม mena_partner · โค้ดรถร่วมอ่านตัวนี้ ห้ามอ่าน MONGO_DB
PARTNER_MONGO_DB=mena_partner
# 0 = ไม่ให้แอปสร้างดัชนีเอง (ผู้ใช้ฐานไม่มีสิทธิ์ createIndex)
MONGO_AUTO_INDEX=

# ── ล็อกอิน (session ของ hr เท่านั้น — ไม่มี next-auth / NEXTAUTH_* แล้ว) ────
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_NCAC_URL=
APP_URL=
# อีเมลที่ได้บทบาท superadmin ของระบบรถร่วม คั่นด้วยจุลภาค (ที่เหลืออ่านจาก mena_partner.app_users · ไม่พบ = viewer)
SUPERADMIN_EMAILS=

# ── ไฟล์ ─────────────────────────────────────────────────────────────────
API_PRESIGN_URL=
# DigitalOcean Spaces ของระบบรถร่วม (เอกสารสัญญา รูปรถ รูปคนขับ)
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_FOLDER=

# ── cron (Vercel ส่ง Authorization: Bearer <CRON_SECRET>) ───────────────────
CRON_SECRET=

# ── เว็บขายรถสาธารณะ /trucks — ใช้ทำ sitemap / canonical / og (โดเมนรอเจ้าของตัดสิน G3)
NEXT_PUBLIC_SITE_URL=

# ── ค่าจ้าง ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYROLL_APPROVER_DEPARTMENTS=
NEXT_PUBLIC_PAYROLL_OWNER_DEPARTMENTS=
